{
  "name": "crca-website-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/apply-sermon-settings.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "sync-docs": "node scripts/sync-crca-docs.mjs",
    "build:au-locations": "node scripts/build-au-locations.mjs",
    "build:with-sync": "npm run sync-docs && npm run build",
    "verify": "node scripts/verify-site.mjs",
    "verify:links": "node scripts/verify-site.mjs --links",
    "deploy:pages": "node scripts/deploy-gh-pages.mjs",
    "deploy:preview": "node scripts/deploy-gh-pages-preview.mjs",
    "sync-safe-church": "node scripts/sync-safe-church.mjs",
    "build:sermon-topics": "node scripts/build-sermon-topics.mjs",
    "sync-sermons": "node scripts/sync-sermons.mjs",
    "sync-all": "npm run sync-docs && npm run sync-safe-church && npm run sync-sermons",
    "qa": "node scripts/qa-site.mjs",
    "build:spa": "tsc -b && vite build && node scripts/apply-sermon-settings.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "images": "node scripts/optimise-images.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.49.1",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
