<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # /documents is both a folder (synced docs) and a legacy page URL
  RewriteRule ^documents/?$ /for-churches/forms-and-documents [R=301,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
